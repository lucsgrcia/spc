<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.BarbershopController"
            prefWidth="1100" prefHeight="520">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <left>
        <VBox spacing="12" prefWidth="340" style="-fx-background-color: #f5f5f5; -fx-border-color: #d0d0d0; -fx-border-width: 1px;">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <Label text="Cadastro do cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="12" vgap="12">
                <padding>
                    <Insets top="8" right="0" bottom="8" left="0"/>
                </padding>

                <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nomeField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="CPF:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="cpfField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Idade:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="idadeField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dataPicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Salvar" onAction="#salvarCliente" style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/>
                <Button text="Limpar" onAction="#limparFormulario"/>
                <Button text="Excluir" onAction="#excluirCliente" style="-fx-background-color: #c62828; -fx-text-fill: white;"/>
            </HBox>

            <Label fx:id="statusLabel" text="Sistema pronto para uso." wrapText="true"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 0 0 0 12;">
            <Label text="Clientes cadastrados" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TableView fx:id="clientTable" prefWidth="700">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="nomeColumn" text="Nome" prefWidth="220"/>
                    <TableColumn fx:id="cpfColumn" text="CPF" prefWidth="120"/>
                    <TableColumn fx:id="idadeColumn" text="Idade" prefWidth="90"/>
                    <TableColumn fx:id="dataColumn" text="Data" prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
